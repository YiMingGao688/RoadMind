{
  "name": "roadmind-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --config=playwright.api.config.ts"
  },
  "dependencies": {
    "axios": "1.20.0",
    "element-plus": "2.14.7",
    "lucide-vue-next": "1.0.0",
    "markdown-it": "15.0.3",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "sass": "1.106.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
